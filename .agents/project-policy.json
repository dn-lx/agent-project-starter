{
  "schema_version": 1,
  "branches": {
    "integration": "dev",
    "production": "prod",
    "work_prefixes": [
      "feature/",
      "fix/",
      "chore/"
    ],
    "development_write_mode": "direct_commit"
  },
  "release": {
    "production_requires_explicit_approval": true,
    "approval_label": "production-approved",
    "only_integration_may_target_production": true
  },
  "continuity": {
    "draft_pr_for_non_trivial_work": false,
    "one_writer_per_task_branch": true,
    "github_state_over_chat_memory": true,
    "direct_integration_commits_allowed": true
  }
}
